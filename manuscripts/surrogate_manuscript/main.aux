\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Input--output mapping of the P3D{} surrogate. Six channels (normalised velocity state $\mathbf  {s}_t$, binary geometry mask $\mathbf  {g}$, and broadcast parameter channels $\bar  {\bm  {\theta }}_t$) are concatenated and fed to P3D-S{}. The network predicts a residual increment $\Delta _\theta $; the final state estimate $\hat  {\mathbf  {s}}_{t+1} = \mathbf  {s}_t + \sigma _s\Delta _\theta \odot \mathbf  {g}$ adds the skip connection and re-applies the geometry mask.\relax }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:io}{{1}{3}{Input--output mapping of the \pthreed {} surrogate. Six channels (normalised velocity state $\state _t$, binary geometry mask $\mask $, and broadcast parameter channels $\bthbar _t$) are concatenated and fed to \pthreeds {}. The network predicts a residual increment $\resid $; the final state estimate $\shat _{t+1} = \state _t + \sstd \resid \odot \mask $ adds the skip connection and re-applies the geometry mask.\relax }{figure.caption.1}{}}
