# pixi environments
.pixi/*
!.pixi/config.toml

# Environment lockfiles (the root Pixi lock is versioned).
pyproject.lock

# python cache
__pycache__/
*.pyc

# Local agent files (personal permissions, scratch plans)
.claude/settings.local.json
.claude/plans/


##### pyudales #####
libs/pyudales/u-dales/*
libs/pyudales/outputs/*
libs/pyudales/experiments/*
libs/pyudales/.pixi/*
libs/pyudales/pixi.lock
libs/pyudales/pyproject.lock
libs/pyudales/__pycache__/*
libs/pyudales/*.pyc

##### pypalm #####
libs/pypalm/palm_model_system/
libs/pypalm/palm_model_system.tar.gz
libs/pypalm/__pycache__/*
libs/pypalm/*.pyc

# Raw geometry exports dropped at the repo root (buildings.stl,
# groundpatched_extrude.stl, ...). These are inputs to
# scripts/tools/prepare_case_stl.py — often hundreds of MB — and are converted
# into the committed, domain-frame STL under examples/<case>/. Never commit the
# raw ones.
/*.stl
/*.STL

# UrbanTALES geometry dataset — bulk data (~350 MB rasters + ~600 MB STLs),
# regenerable via examples/geometries/{download_urbantales_geometries,rasters_to_stl}.py.
# The scripts stay tracked; the downloaded/derived data does not.
examples/geometries/raw/
examples/geometries/processed/

# Figures and animations
*.pdf
*.png
*.mp4
*.gif
figures/*

# torch weights
*.pt

# trained model weights
model_weights/

# macOS files
*.DS_Store

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.out
*.log

# job output files
job_scripts/delftblue/out_files/*
job_scripts/snellius/out_files/*
!job_scripts/*/out_files/.gitkeep
slurm-*.out

# training data
training_data/*

# cache
.cache/*

# Stray Hydra default run dir (when a script runs without the configured run.dir).
outputs/

# latex (manuscripts)
latex/

# Ground truth simulations
ground_truth/*

# temp / run folders
.temp
.temp_lbm/*
.temp_pyudales/*
.local_runs/*

# Metrics and comparison
comparison/*
sweep_metrics/*

# generated artifacts
state.nc
params.nc

# Results
results/*
