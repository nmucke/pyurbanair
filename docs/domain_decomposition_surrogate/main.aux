\citation{ronneberger2015unet}
\citation{bartal2023multidiffusion}
\citation{ronneberger2015unet}
\citation{bartal2023multidiffusion}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Partition-of-unity windows along one axis.} Each interior is extended by the taper width $\delta $ so adjacent Hann windows overlap by $2\delta $; inside the overlap two windows ramp so their sum stays $1$. Dividing by the overlap sum makes $\DOTSB \sum@ \slimits@ _i w_i\equiv 1$ exact, so the merge is a smooth convex blend across every seam \cite  {ronneberger2015unet,bartal2023multidiffusion}.\relax }}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pou}{{4}{4}{\textbf {Partition-of-unity windows along one axis.} Each interior is extended by the taper width $\delta $ so adjacent Hann windows overlap by $2\delta $; inside the overlap two windows ramp so their sum stays $1$. Dividing by the overlap sum makes $\sum _i w_i\equiv 1$ exact, so the merge is a smooth convex blend across every seam \cite {ronneberger2015unet,bartal2023multidiffusion}.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Periodicity}{4}{subsection.3.3}\protected@file@percent }
\newlabel{sec:periodic}{{3.3}{4}{Periodicity}{subsection.3.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The coarse global level}{4}{section.4}\protected@file@percent }
\newlabel{sec:coarse}{{4}{4}{The coarse global level}{section.4}{}}
\newlabel{eq:coarse}{{4}{4}{The coarse global level}{equation.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Periodic wrap-around (shown for $y$).} A seam-adjacent patch reads its halo circularly --- the last $h$ cells fill the left ghost halo and the first $h$ cells fill the right one --- so $\mathcal  {R}_i$ reads true neighbours, not a wall. The partition-of-unity window overhang is wrap-added across the seam in the same way, so $\DOTSB \sum@ \slimits@ _i w_i\equiv 1$ holds across $y=N_y\equiv 0$ and the merge is seamless there. Requires $n\mid N_y$.\relax }}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:periodic}{{5}{5}{\textbf {Periodic wrap-around (shown for $y$).} A seam-adjacent patch reads its halo circularly --- the last $h$ cells fill the left ghost halo and the first $h$ cells fill the right one --- so $\Rop _i$ reads true neighbours, not a wall. The partition-of-unity window overhang is wrap-added across the seam in the same way, so $\sum _i w_i\equiv 1$ holds across $y=N_y\equiv 0$ and the merge is seamless there. Requires $n\mid N_y$.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The coarse level.} The fine state is average-pooled by a factor $r$ to a small coarse grid, a dedicated coarse network takes one step there, and the result is trilinearly prolonged back to the fine grid as the global context field $\bm  {C}_t$. The coarse pass costs $r^{3}$ fewer cells than a fine step.\relax }}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:coarse}{{6}{5}{\textbf {The coarse level.} The fine state is average-pooled by a factor $r$ to a small coarse grid, a dedicated coarse network takes one step there, and the result is trilinearly prolonged back to the fine grid as the global context field $\bm C_t$. The coarse pass costs $r^{3}$ fewer cells than a fine step.\relax }{figure.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Why a dedicated coarse net.}{5}{paragraph*.8}\protected@file@percent }
