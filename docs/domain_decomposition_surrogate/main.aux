\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {One step of the two-level domain-decomposed update.} \emph  {Top (indigo):} a cheap coarse predictor average-pools the state by a factor $r$, takes one low-resolution step, and prolongs the result to a fine-grid \emph  {context} field $\bm  {C}_t$ that carries global coupling. \emph  {Bottom (teal):} the field is tiled into overlapping blocks; a single shared fine network predicts a residual per patch from the patch state, its halo, geometry, parameters, the restricted context $\mathcal  {R}_i\bm  {C}_t$ and a positional encoding $\bm  {e}_i$; the outputs are cropped to their interiors and blended by a partition of unity into the next state $\bm  {S}_{t+1}$. The whole diagram is one call of \texttt  {DomainDecomposed.forward}.\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{\textbf {One step of the two-level domain-decomposed update.} \emph {Top (indigo):} a cheap coarse predictor average-pools the state by a factor $r$, takes one low-resolution step, and prolongs the result to a fine-grid \emph {context} field $\bm C_t$ that carries global coupling. \emph {Bottom (teal):} the field is tiled into overlapping blocks; a single shared fine network predicts a residual per patch from the patch state, its halo, geometry, parameters, the restricted context $\Rop _i\bm C_t$ and a positional encoding $\bm e_i$; the outputs are cropped to their interiors and blended by a partition of unity into the next state $\bm S_{t+1}$. The whole diagram is one call of \code {DomainDecomposed.forward}.\relax }{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Problem setup and notation}{2}{section.2}\protected@file@percent }
\newlabel{sec:notation}{{2}{2}{Problem setup and notation}{section.2}{}}
\newlabel{eq:truth}{{1}{2}{Problem setup and notation}{equation.2.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Subdomains, interiors, halos.}{2}{paragraph*.3}\protected@file@percent }
\newlabel{eq:restrict-extend}{{2}{2}{Subdomains, interiors, halos}{equation.2.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Overlapping decomposition.} Each subdomain predicts its interior block $\Omega _i^\circ $ (teal) but reads inputs from the larger extended block $\hat  \Omega _i$ (hatched), which adds a halo of width $h$ taken from neighbouring cells. Interior blocks tile the domain edge-to-edge; extended blocks overlap by $2h$.\relax }}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:decomp}{{2}{3}{\textbf {Overlapping decomposition.} Each subdomain predicts its interior block $\Omega _i^\circ $ (teal) but reads inputs from the larger extended block $\hat \Omega _i$ (hatched), which adds a halo of width $h$ taken from neighbouring cells. Interior blocks tile the domain edge-to-edge; extended blocks overlap by $2h$.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Uniform tiling by padding (one axis).} A non-periodic axis is padded up to a multiple of the interior size $n$ (grey, replicate/zero) so interior tiles (dashed, width $n$) cover it exactly, then a halo of width $h$ (orange) is added on each side. Every extended block is then a uniform $(n+2h)$ along this axis, which lets all $M$ patches batch into one network call. The final merged field is cropped back to $N_x$.\relax }}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:tiling}{{3}{3}{\textbf {Uniform tiling by padding (one axis).} A non-periodic axis is padded up to a multiple of the interior size $n$ (grey, replicate/zero) so interior tiles (dashed, width $n$) cover it exactly, then a halo of width $h$ (orange) is added on each side. Every extended block is then a uniform $(n+2h)$ along this axis, which lets all $M$ patches batch into one network call. The final merged field is cropped back to $N_x$.\relax }{figure.caption.5}{}}
