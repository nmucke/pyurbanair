+  subroutine discrepancy_check_clocks
+    use modglobal, only : timee, dt
+    use modmpi, only : myid, comm3d, mpierr, my_real
+    implicit none
+    real :: clocks(2), clocks_min(2), clocks_max(2)
+    integer :: invalid_local, invalid_global
+    if (.not. lsgs_discrepancy) return
+    clocks = [timee,dt]
+    invalid_local = 0
+    if (.not. all(ieee_is_finite(clocks))) invalid_local = 1
+    call MPI_ALLREDUCE(invalid_local,invalid_global,1,MPI_INTEGER,MPI_MAX,comm3d,mpierr)
+    if (invalid_global /= 0) then
+      if (myid == 0) write(0,*) 'ERROR: nonfinite SGS discrepancy startup clock'
+      call MPI_ABORT(comm3d,1,mpierr)
+    end if
+    call MPI_ALLREDUCE(clocks,clocks_min,2,MY_REAL,MPI_MIN,comm3d,mpierr)
+    call MPI_ALLREDUCE(clocks,clocks_max,2,MY_REAL,MPI_MAX,comm3d,mpierr)
+    if (any(clocks_min /= clocks_max)) then
+      if (myid == 0) write(0,*) 'ERROR: inconsistent SGS discrepancy startup timee/dt across ranks'
+      call MPI_ABORT(comm3d,1,mpierr)
+    end if
+  end subroutine discrepancy_check_clocks
+
+  subroutine discrepancy_report
+    use modglobal, only : cexpnr
+    use modmpi, only : myid, comm3d, mpierr, my_real
+    implicit none
+    real :: global_min, global_max, global_saturated, global_samples
+    integer :: unit, ierr
+    if (.not. lsgs_discrepancy) return
+    call MPI_REDUCE(discrepancy_min,global_min,1,MY_REAL,MPI_MIN,0,comm3d,mpierr)
+    call MPI_REDUCE(discrepancy_max,global_max,1,MY_REAL,MPI_MAX,0,comm3d,mpierr)
+    call MPI_REDUCE(discrepancy_saturated,global_saturated,1,MY_REAL,MPI_SUM,0,comm3d,mpierr)
+    call MPI_REDUCE(discrepancy_samples,global_samples,1,MY_REAL,MPI_SUM,0,comm3d,mpierr)
+    if (myid /= 0) return
+    open(newunit=unit,file='sgs_discrepancy.'//cexpnr//'.txt',status='replace',iostat=ierr)
+    if (ierr /= 0) then
+      write(0,*) 'ERROR: cannot write SGS discrepancy diagnostics'
+      call MPI_ABORT(comm3d,1,mpierr)
+    end if
+    write(unit,'(a,es24.16)') 'multiplier_min=',global_min
+    write(unit,'(a,es24.16)') 'multiplier_max=',global_max
+    write(unit,'(a,es24.16)') 'saturation_fraction=',global_saturated/max(1.,global_samples)
+    write(unit,'(a,es24.16)') 'evaluated_cells=',global_samples
+    write(unit,'(a,es24.16)') 'saturation_threshold=',0.95
+    write(unit,'(a,es24.16)') 'sgs_bias_b0=',sgs_bias_b0
+    write(unit,'(a,es24.16)') 'sgs_bias_b1=',sgs_bias_b1
+    write(unit,'(a,es24.16)') 'sgs_bias_b2=',sgs_bias_b2
+    write(unit,'(a,es24.16)') 'canopy_height=',sgs_discrepancy_height
+    write(unit,'(a,es24.16)') 'height_a_over_h=',sgs_discrepancy_za_over_h
+    write(unit,'(a,es24.16)') 'height_b_over_h=',sgs_discrepancy_zb_over_h
+    write(unit,'(a,es24.16)') 'gradient_regularization=',sgs_discrepancy_epsilon
+    write(unit,'(a,es24.16)') 'log_multiplier_cap=',sgs_discrepancy_cap
+    close(unit)
+  end subroutine discrepancy_report
 
